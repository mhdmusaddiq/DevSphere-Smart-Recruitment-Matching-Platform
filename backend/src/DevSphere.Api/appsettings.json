{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=DevSphereDb;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "JwtSettings": {
    "Issuer": "DevSphere.Api",
    "Audience": "DevSphere.Client",
    "ExpiryMinutes": 60
  },

  "AuthRateLimits": {
    "Login": {
      "AccountFailedAttempts": 5,
      "AccountWindowMinutes": 15,
      "IpPermitLimit": 30,
      "IpWindowMinutes": 15
    },
    "VerificationIssue": {
      "EmailIssueLimit": 5,
      "EmailWindowMinutes": 60,
      "CooldownSeconds": 60,
      "IpPermitLimit": 20,
      "IpWindowMinutes": 60
    },
    "VerificationConsume": {
      "ChallengeFailedAttempts": 5,
      "ChallengeLifetimeMinutes": 10,
      "IpPermitLimit": 30,
      "IpWindowMinutes": 15
    },
    "RecoveryIssue": {
      "EmailIssueLimit": 5,
      "EmailWindowMinutes": 60,
      "CooldownSeconds": 60,
      "IpPermitLimit": 20,
      "IpWindowMinutes": 60
    },
    "ResetConsume": {
      "ChallengeFailedAttempts": 5,
      "ChallengeLifetimeMinutes": 10,
      "IpPermitLimit": 30,
      "IpWindowMinutes": 15
    }
  },

  "FileStorage": {
    "RootPath": "App_Data/Files",
    "MaximumFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".pdf" ],
    "AllowedContentTypes": [
      "application/pdf"
    ]
  },

  "Email": {
    "Smtp": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "AptLens"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
